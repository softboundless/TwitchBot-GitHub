# Copy to .env or use npm run setup. Never commit real secrets.

# Client ID приложения Twitch
# Из консоли dev.twitch.tv/console/apps. Это приложение, а не логин бота.
TWITCH_CLIENT_ID=

# Client Secret приложения Twitch
# Секрет приложения. После сохранения значение скрывается.
TWITCH_CLIENT_SECRET=

# Каналы Twitch
# Логины через запятую, без ссылок. Первый канал — основной; порядок сохраняет привязку owner.json.
TWITCH_CHANNELS=

# Доступ модераторов канала
# Владелец всегда имеет доступ. Модераторы определяются по бейджу текущего чата.
ALLOW_CHANNEL_MODERATORS=true

# Дополнительные администраторы
# Необязательно. Логины через запятую: доступ во всех каналах без отдельного переопределения.
MODS=

# Длительность опроса, секунд
# 
POLL_DEFAULT_SECONDS=120

# Длительность прогноза, секунд
# 
PRED_DEFAULT_SECONDS=60

# Игровые команды
# Общий переключатель всех игр.
GAMES_ENABLED=true

# Каналы с играми
# Пусто — все настроенные каналы.
GAMES_CHANNELS=

# Начальный доступ к играм
# Для новых данных. После запуска режим сохраняется командами !вкл, !выкл, !выклвип.
GAMES_DEFAULT_MODE=off

# Ссылка на описание игр
# Необязательно. Ссылка для !инфо и напоминания раз в 30 минут в режиме для всех.
FUN_COMMANDS_URL=

# API-ключ Groq
# Только для !расклад. Остальные игры работают без ключа.
GROQCLOUD_API_KEY=

# Модель Groq
# Идентификатор модели из вашего аккаунта Groq.
GROQCLOUD_MODEL=openai/gpt-oss-20b

# Автоматический закреп
# Проверка при запуске и смене состояния стрима. Текст задаётся ниже для каждого канала.
AUTO_PIN=false

# Каналы с автозакрепом
# Пусто — все настроенные каналы.
AUTO_PIN_CHANNELS=

# Общий текст закрепа
# Используется, если у канала нет отдельного текста.
AUTO_PIN_MESSAGE=

# Пауза после конца стрима, мс
# 
AUTO_PIN_OFFLINE_DELAY_MS=3000

# Автоматический разбан
# Включайте только для нужного аккаунта и каналов.
AUTO_UNBAN=false

# Каналы с авторазбаном
# Пусто — только первый канал.
AUTO_UNBAN_CHANNELS=

# Кого разбанивать
# Логин Twitch.
AUTO_UNBAN_TARGET=

# После каких модераторов
# Логины через запятую. Пусто — после любого модератора.
AUTO_UNBAN_ONLYFROM=

# Разбан при запуске
# При запуске автор исходного бана не проверяется.
AUTO_UNBAN_ON_START=false

# Интервал проверки связи, секунд
# 
AUTO_UNBAN_INTERVAL=1

# Максимум разбанов за минуту
# 
AUTO_UNBAN_MAX_PER_MINUTE=100

# Музыка и команда !трек
# Выключено — музыкальные подключения не запускаются, !трек игнорируется.
MUSIC_ENABLED=false

# Каналы с !трек
# Пусто — все настроенные каналы. Команда доступна зрителям.
MUSIC_CHANNELS=

# OAuth-токен Яндекс Музыки
# Для определения трека через Python. Для браузерного моста необязателен.
YANDEX_MUSIC_TOKEN=

# Путь к Python
# Пусто — .venv-ynison в папке бота. Требуется только для варианта с токеном Яндекса.
YANDEX_MUSIC_PYTHON=

# Пауза между !трек, мс
# 
TRACK_COOLDOWN_MS=5000

# Секрет браузерного моста
# Для моста задайте случайную строку длиной от 32 символов.
TRACK_BRIDGE_SECRET=

# Адрес браузерного моста
# На VPS обычно оставьте 127.0.0.1 и используйте HTTPS reverse proxy.
TRACK_BRIDGE_HOST=127.0.0.1

# Порт браузерного моста
# 
TRACK_BRIDGE_PORT=8787

# Актуальность трека, мс
# 
TRACK_BRIDGE_MAX_AGE_MS=15000

# HTTPS-адрес /api/track
# Для создания userscript: https://ваш-домен/api/track. Не нужен в варианте без музыки.
TRACK_BRIDGE_PUBLIC_URL=

# Резервная интеграция Fossabot
# Дополнительная интеграция; требует настроенного моста.
FOSSABOT_TRACK_API_ENABLED=false

# Каналы Fossabot
# Пусто — все каналы, в которых разрешена музыка.
FOSSABOT_TRACK_CHANNELS=

# Тайм-аут Fossabot, мс
# 
FOSSABOT_API_TIMEOUT_MS=5000

# Commands disabled for every channel (comma separated).
DISABLED_COMMANDS=

# Optional per-channel overrides, replace MY_CHANNEL with uppercase login.
# MODS_MY_CHANNEL=
# AUTO_PIN_MESSAGE_MY_CHANNEL=
# DISABLED_COMMANDS_MY_CHANNEL=!poll,!каз
